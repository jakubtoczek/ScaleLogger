#include <windows.h>

1 ICON "@CMAKE_SOURCE_DIR@/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SCALELOGGER_VERSION_COMMA@
 PRODUCTVERSION @SCALELOGGER_VERSION_COMMA@
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "ScaleLogger"
      VALUE "FileDescription", "ScaleLogger"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductName", "ScaleLogger"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
END
