{
  "config_folder": "%LOCALAPPDATA%\\ScaleLogger",
  "config_file_name": "ScaleLogger.config.json",
  "presets_folder": "%LOCALAPPDATA%\\ScaleLogger\\presets",
  "logs_folder": "%LOCALAPPDATA%\\ScaleLogger\\logs",
  "log_file_pattern": "ScaleLogger_%Y%m%d_%H%M%S.log",
  "log_mode": "per_session",
  "line_log_mode": "compact",
  "baud_rates": [1200, 2400, 4800, 9600],
  "data_bits_options": [7, 8],
  "parity_options": ["O", "N", "E"],
  "stop_bits_options": ["1", "1.5", "2"],
  "connect_on_startup": true,
  "dark_mode": false,
  "startup_mode": "last_used_preset",
  "startup_preset_name": "",
  "last_used_preset_name": "",
  "standalone_mode": false,
  "port": "COM6",
  "baudrate": 1200,
  "databits": 7,
  "parity": "O",
  "stopbits": 1.0,
  "timeout": 1.0,
  "eol": "\\r\\n",
  "mode": "parsed",
  "trim_whitespace": true,
  "strip_suffix": true,
  "suffix": "g",
  "normalize_sign": true,
  "preserve_plus_sign": true,
  "preserve_minus_sign": true,
  "numeric_validation": true,
  "post_action": "down",
  "custom_sequence": []
}
